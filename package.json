{
  "name": "zimra-fdms",
  "version": "0.4.0",
  "description": "TypeScript SDK for the ZIMRA Fiscalisation Data Management System (FDMS): a portable fiscal core with device registration, mTLS, receipt signing, fiscal days, offline queue and QR codes, plus Node, CLI and MCP adapters",
  "keywords": [
    "zimra",
    "fdms",
    "fiscalisation",
    "fiscalization",
    "zimbabwe",
    "tax",
    "receipt",
    "pos",
    "invoice",
    "vfd",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Shaun Chivandire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munashe-chivandire/zimra-fdms.git"
  },
  "bugs": {
    "url": "https://github.com/munashe-chivandire/zimra-fdms/issues"
  },
  "homepage": "https://github.com/munashe-chivandire/zimra-fdms#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --experimental-vm-modules --test test/*.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "register": "tsx scripts/register.ts",
    "spec:drift": "tsx scripts/spec-drift.ts",
    "pretest": "npm run build && npm run lint:core",
    "test:e2e:mcp": "node scripts/mcp-e2e.mjs",
    "lint:core": "node scripts/check-core-portable.mjs",
    "simulator": "tsx src/simulator/cli.ts",
    "vectors": "tsx scripts/gen-vectors.ts"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@peculiar/x509": "^1.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "zimra-fdms": "dist/node/cli.js",
    "zimra-fdms-simulator": "dist/simulator/cli.js",
    "zimra-fdms-conformance": "dist/conformance/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json",
    "./simulator": {
      "types": "./dist/simulator/index.d.ts",
      "import": "./dist/simulator/index.js"
    },
    "./vectors": "./vectors/zimra-fdms-vectors.json"
  }
}
