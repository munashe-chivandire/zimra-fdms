{
  "name": "zimra-fdms",
  "version": "0.0.1",
  "description": "TypeScript SDK for the ZIMRA Fiscalisation Data Management System (FDMS) API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "register": "tsx scripts/register.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@peculiar/x509": "^1.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
